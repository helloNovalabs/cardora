{
  "rewrites": [
    {
      "source": "/tcg/:path*",
      "destination": "https://tcgcsv.com/tcgplayer/:path*"
    },
    {
      "source": "/((?!assets/|tcg/|.*\\.(?:js|css|map|png|jpe?g|webp|avif|gif|svg|ico|json|webmanifest|txt|xml|woff2?|mp4)$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/tcg/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=21600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}